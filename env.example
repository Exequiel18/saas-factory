# ============================================
# SAAS FACTORY - VARIABLES DE ENTORNO
# ============================================
# Copia este archivo a .env.local y completa los valores
# cp env.example .env.local

# ============================================
# 🔐 AUTENTICACIÓN (REQUERIDO)
# ============================================
# URL pública de tu aplicación
NEXTAUTH_URL=http://localhost:3000
# Genera un secret con: node scripts/generate-secret.js
NEXTAUTH_SECRET=

# ============================================
# 🗄️ BASE DE DATOS (REQUERIDO)
# ============================================
# Para desarrollo local puedes usar SQLite:
# DATABASE_URL="file:./dev.db"
# Para producción usa PostgreSQL:
DATABASE_URL=postgresql://usuario:password@host:puerto/database

# ============================================
# 💳 MERCADO PAGO (REQUERIDO)
# ============================================
# Obtén estas credenciales en:
# https://www.mercadopago.com.ar/developers/panel
# IMPORTANTE: Usa credenciales de PRODUCCIÓN, no test

# Access Token de Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=APP_USR-tu-access-token-aqui

# Public Key de Mercado Pago (debe empezar con NEXT_PUBLIC_)
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-tu-public-key-aqui

# Tu alias de Mercado Pago (ej: aliascomun.mp)
MERCADOPAGO_ALIAS=tu-alias.mp

# Secret para validar webhooks de Mercado Pago
# Lo obtienes al configurar el webhook en el panel de MP
MERCADO_PAGO_WEBHOOK_SECRET=tu-webhook-secret-aqui

# ============================================
# 📧 EMAIL (OPCIONAL - Elige una opción)
# ============================================

# Opción 1: SendGrid
SENDGRID_API_KEY=tu-sendgrid-api-key
EMAIL_FROM=noreply@tudominio.com

# Opción 2: Resend
# RESEND_API_KEY=re_tu-resend-key

# Opción 3: SMTP Personalizado
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=tu-email@tudominio.com
# SMTP_PASS=tu-password

# ============================================
# 🔔 WEBHOOKS Y APIs (OPCIONAL)
# ============================================
# URL para webhooks externos (ej: N8N, Zapier)
OUTBOUND_WEBHOOK_URL=https://tu-webhook-url.com

# API Keys para endpoints protegidos
EMAIL_API_KEY=tu-email-api-key
ALERT_API_KEY=tu-alert-api-key
EMPIRE_SECRET=tu-empire-secret

# ============================================
# 🌍 CONFIGURACIÓN GENERAL (OPCIONAL)
# ============================================
# Moneda por defecto
CURRENCY=ARS

# URL de Vercel (se configura automáticamente en producción)
NEXT_PUBLIC_VERCEL_URL=

# ============================================
# 🚀 PRODUCCIÓN
# ============================================
# En producción (Vercel, Railway, etc.), configura estas variables
# en el panel de tu proveedor de hosting.
# NO subas el archivo .env.local a Git.

# ============================================
# 📝 NOTAS
# ============================================
# 1. Genera NEXTAUTH_SECRET con:
#    node scripts/generate-secret.js
#
# 2. Para obtener credenciales de Mercado Pago:
#    - Ve a: https://www.mercadopago.com.ar/developers/panel
#    - Crea una aplicación
#    - Copia Access Token y Public Key
#    - Usa credenciales de PRODUCCIÓN
#
# 3. Configura el webhook de Mercado Pago:
#    - URL: https://tu-dominio.com/api/mercadopago/webhook
#    - Eventos: payment.created, payment.updated
#    - Copia el secret del webhook a MERCADO_PAGO_WEBHOOK_SECRET
#
# 4. Para base de datos en producción:
#    - Vercel: Storage → Create Postgres (recomendado)
#    - Railway: https://railway.app (gratis)
#    - PlanetScale: https://planetscale.com (gratis)

